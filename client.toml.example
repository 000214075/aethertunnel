# AetherTunnel client configuration — v3.1.0
#
# Start with:  aethertunnel-client --config client.toml
# Validate:    aethertunnel-client --config client.toml --check

[client]
# host:port of the AetherTunnel server.
server_addr = "127.0.0.1:7001"

# Must match the server's auth_token.
auth_token = "CHANGE-ME-use-at-least-16-random-characters"

# Reconnect backoff: starts at reconnect_seconds and doubles up to
# max_reconnect_seconds, with ±20% jitter so a fleet does not retry in lockstep.
reconnect_seconds = 3
max_reconnect_seconds = 60

# Seconds between heartbeats, and how long to wait for the server to answer a
# data-stream request.
heartbeat_seconds = 30
dial_timeout_seconds = 10

# Drop a tunnelled stream that has been idle for this many seconds.
idle_timeout_seconds = 300

[encryption]
# Must match the server exactly. Empty passphrase means "derive from auth_token".
enabled = false
algorithm = "xchacha20-poly1305"   # or "aes-256-gcm"
passphrase = ""
salt = "aethertunnel"

# One [[proxies]] block per service you want to publish. Only type "tcp" is
# implemented in this version; other types are rejected with an explicit error
# rather than being accepted and then doing nothing.
#
# remote_port is the port opened on the *server*; visitors connect there and the
# bytes are forwarded to local_ip:local_port on this machine. Set remote_port = 0
# to register the tunnel without a public port.

[[proxies]]
name = "ssh"
type = "tcp"
local_ip = "127.0.0.1"
local_port = 22
remote_port = 6022

[[proxies]]
name = "web"
type = "tcp"
local_ip = "127.0.0.1"
local_port = 8000
remote_port = 8080
